# Point this at your lims-zekindo dev server's LAN IP (not localhost — Expo
# Go runs on a separate device/emulator and can't reach your machine's
# localhost). Find your IP with `ipconfig getifaddr en0` (macOS) or
# `hostname -I` (Linux), then: npm run dev in lims-zekindo listens on :3000.
EXPO_PUBLIC_API_URL="http://192.168.1.20:3000"
